		{
			"contents": "#=======================================================================\n# lib.jq\n#\n# Internal contract:\n#\n#   array -> stage -> array\n#\n# The final .[] converts the completed array back into JSONL.\n#=======================================================================\n\ninclude \"utilities\";\ninclude \"increase_position\";\n\n#=======================================================================\ndef display_lots_canonically:\n\n  sort_by(\n    .symbol,\n    .open_datetime_raw,\n    .originating_transaction_id,\n    .originating_order_id\n  )\n;\n\n#=======================================================================\ndef update_mark_prices($live):\n\n  ($live | live_positions_to_index) as $live_index\n\n  | map(\n\n    if $live_index[.symbol] then\n\n      .mark_price =\n        $live_index[.symbol].mark_price\n\n      | .position_value =\n          (\n            .mark_price\n            * .quantity\n            * .multiplier\n          )\n\n      | .fifo_pnl_unrealized =\n          (\n            .position_value\n            -\n            (\n              .cost_basis_price\n              * .quantity\n              * .multiplier\n            )\n          )\n\n    else\n\n      .\n\n    end\n\n  )\n;\n\n#=======================================================================\ndef consolidate_lots:\n\n  group_by(\n    [\n      .symbol,\n      .open_datetime_raw,\n      .originating_transaction_id,\n      .originating_order_id\n    ]\n  )\n\n  | map(\n\n    if length == 1 then\n\n      .[0]\n\n    else\n\n      .[0]\n\n      + {\n          quantity:\n            (\n              map(.quantity)\n              | add\n            ),\n\n          position_value:\n            (\n              map(.position_value)\n              | add\n            ),\n\n          fifo_pnl_unrealized:\n            (\n              map(.fifo_pnl_unrealized)\n              | add\n            ),\n\n          cost_basis_price:\n            (\n              (\n                map(\n                  .cost_basis_price\n                  * .quantity\n                )\n                | add\n              )\n              /\n              (\n                map(.quantity)\n                | add\n              )\n            ),\n\n          open_price:\n            (\n              (\n                map(\n                  .open_price\n                  * .quantity\n                )\n                | add\n              )\n              /\n              (\n                map(.quantity)\n                | add\n              )\n            )\n        }\n\n    end\n\n  )\n;\n\n#=======================================================================\ndef classify_bke:\n\n  map(\n\n    if .record_type == \"lot\"\n    and (.fifo_pnl_unrealized >= -5)\n    and (.fifo_pnl_unrealized <= 5)\n\n    then\n\n      .lock_state = \"40.BKE\"\n\n    else\n\n      .\n\n    end\n\n  )\n;\n\n#=======================================================================\ndef classify_los:\n\n  map(\n\n    if .record_type == \"lot\"\n    and .lock_state == \"---\"\n    and (.fifo_pnl_unrealized < -5)\n\n    then\n\n      .lock_state = \"50.LOS\"\n\n    else\n\n      .\n\n    end\n\n  )\n;\n\n#=======================================================================\ndef classify_hvt:\n\n  map(\n\n    if .record_type == \"lot\"\n    and .lock_state == \"---\"\n    and (.fifo_pnl_unrealized > 5)\n\n    then\n\n      .lock_state = \"10.HVT\"\n\n    else\n\n      .\n\n    end\n\n  )\n;\n\n#=======================================================================\ndef classify_lkd:\n\n  group_by(.symbol)\n\n  | map(\n\n    . as $lots\n\n    | reduce range(0; length) as $i\n      (\n\n        $lots;\n\n        if .[$i].record_type == \"lot\"\n        and (\n          .[$i].lock_state == \"10.HVT\"\n          or .[$i].lock_state == \"40.BKE\"\n        )\n        and any(\n          .[$i + 1:][];\n          .record_type == \"lot\"\n          and .lock_state == \"50.LOS\"\n        )\n\n        then\n\n          .[$i].lock_state = \"30.LKD\"\n\n        else\n\n          .\n\n        end\n\n      )\n\n  )\n\n  | add\n;\n\n#=======================================================================\ndef calculate_locking_lots_pnl:\n\n  group_by(.symbol)\n\n  | map(\n\n    . as $lots\n\n    | reduce range(0; length) as $i\n      (\n\n        $lots;\n\n        if .[$i].record_type == \"lot\"\n        and .[$i].lock_state == \"30.LKD\"\n\n        then\n\n          (\n            .[$i + 1:]\n\n            | map(\n                select(\n                  .record_type == \"lot\"\n                  and .lock_state == \"50.LOS\"\n                )\n                | .fifo_pnl_unrealized\n              )\n\n            | if length > 0 then\n                add\n              else\n                0\n              end\n          ) as $locking_lots_pnl\n\n          | .[$i].locking_lots_pnl =\n              $locking_lots_pnl\n\n        else\n\n          .\n\n        end\n\n      )\n\n  )\n\n  | add\n;\n\n#=======================================================================\ndef classify_pba:\n\n  group_by(.symbol)\n\n  | map(\n\n    (\n      map(\n        select(\n          .record_type == \"lot\"\n          and .lock_state == \"50.LOS\"\n        )\n      )\n    ) as $los\n\n    | if ($los | length) == 0 then\n\n        .\n\n      else\n\n        (\n          $los\n          | max_by(.cost_basis_price)\n          | .cost_basis_price\n        ) as $max_cost\n\n        | map(\n\n            if .record_type == \"lot\"\n            and .lock_state == \"50.LOS\"\n            and .cost_basis_price == $max_cost\n            and .cost_basis_price >= .mark_price\n\n            then\n\n              .lock_state = \"20.PBA\"\n\n            else\n\n              .\n\n            end\n\n          )\n\n      end\n\n  )\n\n  | add\n;\n\n#=======================================================================\ndef aggregate_hvt:\n\n  . as $records\n\n  | [\n      $records[]\n\n      | select(\n          .record_type == \"lot\"\n          and .lock_state == \"10.HVT\"\n        )\n    ]\n\n  | group_by(.symbol)\n\n  | map(\n\n      sort_by(.open_datetime_raw)\n\n      | . as $lots\n\n      | $lots[0] as $oldest\n\n      | $oldest\n\n      | .record_type = \"aggregate\"\n\n      | .lock_state = \"15.HVT\"\n\n      | .quantity =\n          (\n            $lots\n            | map(.quantity)\n            | add\n          )\n\n      | .open_price =\n          (\n            $lots\n            | map(.open_price)\n            | max\n          )\n\n      | .cost_basis_price =\n          (\n            $lots\n            | map(.cost_basis_price)\n            | max\n          )\n\n      | .fifo_pnl_unrealized =\n          (\n            (\n              $lots\n              | map(.fifo_pnl_unrealized)\n              | add\n            )\n\n            - 1.12\n          )\n\n    )\n\n  | ($records + .)\n;\n\n#=======================================================================\ndef classify_locking:\n\n  group_by(.symbol)\n\n  | map(\n\n    . as $lots\n\n    | reduce range(0; length) as $i\n    (\n\n      $lots;\n\n      if .[$i].record_type == \"lot\"\n      and .[$i].lock_state == \"30.LKD\"\n\n      then\n\n        (\n          .[$i + 1:]\n\n          | map(\n              select(\n                .record_type == \"lot\"\n                and .lock_state == \"50.LOS\"\n              )\n            )\n\n          | last\n        ) as $locker\n\n        | if $locker then\n\n            .[$i].locking_lot_id =\n              $locker.lot_id\n\n            | .[$i].lock_condition =\n                \"◆\"\n                + (\n                    (\n                      (\n                        $locker.open_price\n                        + 3 / $locker.quantity\n                      )\n                      | floor\n                    )\n                    | tostring\n                  )\n                + \"x\"\n                + ($locker.quantity | tostring)\n                + \"▶\"\n                + ($locker.open_date | sub(\"^20\"; \"\"))\n\n          else\n\n            .\n\n          end\n\n      else\n\n        .\n\n      end\n\n    )\n\n  )\n\n  | add\n;\n\n#=======================================================================\ndef calculate_lot_age:\n\n  . as $records\n\n  | (now | strftime(\"%Y-%m-%d\")) as $current_date\n\n  | $records\n\n  | map(\n\n      if (\n        .record_type == \"lot\"\n        or .record_type == \"aggregate\"\n      )\n\n      then\n\n        .lot_age = (\n          (\n            (\n              (\n                (\n                  ($current_date + \"T00:00:00Z\" | fromdateiso8601)\n                  -\n                  (.open_date + \"T00:00:00Z\" | fromdateiso8601)\n                )\n                / 86400\n              )\n              # * (5 / 7)\n              # * (1 - 12 / 365)\n            )\n            | ceil\n          )\n          | if . < 1 then 1 else . end\n        )\n\n      else\n\n        .\n\n      end\n\n    )\n\n;\n\n#=======================================================================\ndef format_lot_age:\n\n  map(\n    if (\n      .record_type == \"lot\"\n      or .record_type == \"aggregate\"\n      or .record_type == \"summary\"\n    )\n    and (.lot_age | type) == \"number\"\n\n    then\n      .lot_age = (.lot_age | human_duration)\n\n    else\n      .\n    end\n  )\n\n;\n\n#=======================================================================\ndef calculate_summary_lot_age: # test 28\n\n  . as $records\n\n  | map(\n\n      if .record_type == \"summary\"\n\n      then\n\n        .symbol as $symbol\n\n        | .lot_age = (\n            $records\n            | map(\n                select(\n                  .record_type == \"lot\"\n                  and .symbol == $symbol\n                )\n                | .lot_age\n              )\n            | max\n          )\n\n      else\n\n        .\n\n      end\n\n    )\n\n;\n\n\n#=======================================================================\ndef close_position($live):\n\n  . as $records\n\n  | $live\n  | map({(.symbol): .position})\n  | add as $positions\n\n  | $records\n  | map(\n      select(\n        ($positions[.symbol] // null) != 0\n      )\n    )\n\n;\n\n#=======================================================================\ndef new_position($live):\n\n  . as $records\n  | ($records | map(.symbol) | unique) as $li_symbols\n\n  | ($live\n      | map(\n          select(\n            .position != 0\n            and\n            (.symbol as $s | ($li_symbols | index($s)) == null)\n          )\n        )\n    ) as $new_positions\n\n  | reduce $new_positions[] as $p\n      ($records;\n\n       make_derived_record($records[0]; $p; \"summary\") as $summary\n       | make_derived_record($records[0]; $p; \"lot\") as $lot\n       | . + [$summary, $lot]\n      )\n;\n\n#=======================================================================\ndef transform_reversal_records($symbol; $p):\n\n  map(\n    if .symbol == $symbol then\n\n      .quantity = $p.position\n      | .mark_price = $p.mark_price\n      | .open_price = $p.avg_cost\n      | .cost_basis_price = $p.avg_cost\n      | .side = (if $p.position > 0 then \"Long\" else \"Short\" end)\n      # | .position_value = ($p.position * $p.mark_price)\n      | .report_date = (now | strftime(\"%Y%m%d\"))\n      | .open_date = (now | strftime(\"%Y-%m-%d\"))\n\n    else\n      .\n    end\n  )\n;\n\n#=======================================================================\ndef reverse_position($live):\n\n  . as $records\n\n  | ($records\n      | map(\n          select(.record_type == \"summary\")\n          | {(.symbol): .quantity}\n        )\n      | add\n    ) as $li_positions\n\n  | ($live\n      | map(\n          select(\n            .position != 0\n            and\n            (.symbol as $s\n             | ($li_positions[$s] // 0) != 0\n             and\n             (\n               (($li_positions[$s] > 0) and (.position < 0))\n               or\n               (($li_positions[$s] < 0) and (.position > 0))\n             )\n            )\n          )\n        )\n    ) as $reversals\n\n  | reduce $reversals[] as $p\n    ($records;\n     retain_reversal_records($p.symbol)\n     | transform_reversal_records($p.symbol; $p)\n    )\n;\n\n#=======================================================================\ndef decrease_position($live):\n\n  . as $records\n\n  | ($records\n      | map(\n          select(.record_type == \"summary\")\n          | {(.symbol): .quantity}\n        )\n      | add\n    ) as $li_positions\n\n  | ($live\n      | map(\n          select(\n            .position > 0\n            and\n            (.symbol as $s\n             | ($li_positions[$s] // 0) > .position\n            )\n          )\n        )\n    ) as $decreases\n\n  | reduce $decreases[] as $p\n      ($records;\n\n       ($li_positions[$p.symbol] - $p.position) as $decrease\n\n       | reduce range((length - 1); -1; -1) as $i\n           ({records: ., remaining: $decrease};\n\n            if .remaining <= 0 then\n              .\n\n            elif .records[$i].symbol != $p.symbol\n              or .records[$i].record_type != \"lot\"\n              or .records[$i].quantity <= 0 then\n              .\n\n            else\n              (.records[$i].quantity) as $qty\n\n              | if $qty <= .remaining then\n                  .records[$i].quantity = 0\n                  | .remaining -= $qty\n                else\n                  .records[$i].quantity = $qty - .remaining\n                  | .remaining = 0\n                end\n            end\n           )\n\n       | .records\n\n       | map(\n           select(\n             .symbol != $p.symbol\n             or .record_type != \"lot\"\n             or .quantity != 0\n           )\n         )\n\n       | map(\n           if .symbol == $p.symbol\n              and .record_type == \"summary\"\n           then\n             .quantity = $p.position\n           else\n             .\n           end\n         )\n      )\n;\n#=======================================================================\n# Pipeline\n#=======================================================================\ndef pipeline($live):\n\n  display_lots_canonically\n\n  #...\n  | close_position($live)    # new stages\n  | new_position($live)      # new stages\n  | reverse_position($live)  # new stages\n  | increase_position($live) # new stages\n  | decrease_position($live) # new stages (LIFO)\n  #...\n  | update_mark_prices($live)\n\n  | consolidate_lots\n\n  | classify_bke\n  | classify_los\n  | classify_hvt\n\n  | classify_lkd # f(HVT_i, LOS_i)\n  | calculate_locking_lots_pnl # f(HVT_i, LOS_i)\n\n  | classify_pba # f(LOS_i)\n\n  | aggregate_hvt # f(HVT_i)\n\n  | calculate_lot_age\n  | calculate_summary_lot_age\n  | format_lot_age\n\n\n  # | classify_locking # optional --> legacy?\n;\n\n\n#=======================================================================\n# Main\n#=======================================================================\n\npipeline($live)\n| .[]\n\ncommunication_preferences.md\nincremental_experimental_development.md\nsimple_first_engineering_directive.md\nepistemic_honesty.md\ncommunication_preferences.md\n\n",
